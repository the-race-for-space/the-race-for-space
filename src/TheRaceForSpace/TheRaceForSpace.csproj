<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>TheRaceForSpace</AssemblyName>
    <RootNamespace>TheRaceForSpace</RootNamespace>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <!--
      KSP assemblies remain in the local game installation and are never copied
      into this repository. KSP_ROOT should point at the folder containing the
      KSP executable and GameData.
    -->
    <KspManagedPath Condition="'$(KSP_ROOT)' != '' and '$(OS)' == 'Windows_NT'">$(KSP_ROOT)/KSP_x64_Data/Managed</KspManagedPath>
    <KspManagedPath Condition="'$(KSP_ROOT)' != '' and '$(OS)' != 'Windows_NT'">$(KSP_ROOT)/KSP_Data/Managed</KspManagedPath>

    <!--
      .NET Framework targeting packs are Windows-only. On common Linux/Mono
      installations, use Mono's compatible 4.7.2 reference assemblies so the
      SDK can compile the same net472 project without adding a NuGet dependency.
      Other Mono layouts can override FrameworkPathOverride externally.
    -->
    <FrameworkPathOverride Condition="'$(OS)' != 'Windows_NT' and '$(FrameworkPathOverride)' == '' and Exists('/usr/lib/mono/4.7.2-api/mscorlib.dll')">/usr/lib/mono/4.7.2-api</FrameworkPathOverride>
    <EnableFrameworkPathOverride Condition="'$(OS)' != 'Windows_NT' and '$(FrameworkPathOverride)' != ''">true</EnableFrameworkPathOverride>
    <AssemblySearchPaths Condition="'$(OS)' != 'Windows_NT' and '$(FrameworkPathOverride)' != ''">$(FrameworkPathOverride)/Facades;$(AssemblySearchPaths)</AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <!-- KSP gameplay API. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity references used by the current prototype UI and lifecycle code. -->
    <Reference Include="UnityEngine">
      <HintPath>$(KspManagedPath)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KspManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(KspManagedPath)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(KspManagedPath)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(KspManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Give a useful error instead of a long list of unresolved KSP types. -->
  <Target Name="ValidateKspReferences" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(KSP_ROOT)' == ''"
      Text="KSP_ROOT is not set. Point it at the KSP installation folder containing the KSP executable and GameData." />
    <Error
      Condition="!Exists('$(KspManagedPath)/Assembly-CSharp.dll')"
      Text="Could not find KSP managed assemblies under '$(KspManagedPath)'. Check KSP_ROOT and confirm this is a KSP 1.12.x installation." />
  </Target>

  <!--
    Normal builds stay under bin/. Set DeployToKsp=true when you explicitly
    want the freshly built mod DLL and user-editable config copied into KSP.
  -->
  <Target Name="DeployToKspInstallation" AfterTargets="Build" Condition="'$(DeployToKsp)' == 'true'">
    <PropertyGroup>
      <KspPluginPath>$(KSP_ROOT)/GameData/TheRaceForSpace/Plugins</KspPluginPath>
      <KspConfigPath>$(KSP_ROOT)/GameData/TheRaceForSpace/Config</KspConfigPath>
      <RaceSettingsConfigPath>$(MSBuildProjectDirectory)/../../GameData/TheRaceForSpace/Config/RaceSettings.cfg</RaceSettingsConfigPath>
    </PropertyGroup>
    <MakeDir Directories="$(KspPluginPath);$(KspConfigPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(KspPluginPath)" />
    <Copy SourceFiles="$(RaceSettingsConfigPath)" DestinationFolder="$(KspConfigPath)" />
  </Target>
</Project>
