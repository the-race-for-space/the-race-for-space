<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>TheRaceForSpace.ControllerTests</AssemblyName>
    <RootNamespace>TheRaceForSpace.ControllerTests</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Compile the real race controller and its KSP-independent dependencies against
    test-only stand-ins for the controller's existing KSP integration boundaries.
    This exercises orchestration and ordering without requiring a KSP installation.
  -->
  <ItemGroup>
    <Compile Include="../../src/TheRaceForSpace/Campaign/CampaignController.cs" Link="Production/Campaign/CampaignController.cs" />
    <Compile Include="../../src/TheRaceForSpace/Core/CampaignSettings.cs" Link="Production/Core/CampaignSettings.cs" />
    <Compile Include="../../src/TheRaceForSpace/Funding/SatelliteNetworkFundingContract.cs" Link="Production/Funding/SatelliteNetworkFundingContract.cs" />
    <Compile Include="../../src/TheRaceForSpace/Funding/ObjectiveFundingContract.cs" Link="Production/Funding/ObjectiveFundingContract.cs" />
    <Compile Include="../../src/TheRaceForSpace/Funding/FundingContractCatalogue.cs" Link="Production/Funding/FundingContractCatalogue.cs" />
    <Compile Include="../../src/TheRaceForSpace/Objectives/ObjectiveDefinition.cs" Link="Production/Objectives/ObjectiveDefinition.cs" />
    <Compile Include="../../src/TheRaceForSpace/Objectives/ObjectiveCatalogue.cs" Link="Production/Objectives/ObjectiveCatalogue.cs" />
    <Compile Include="../../src/TheRaceForSpace/Objectives/UnlockRuleDefinition.cs" Link="Production/Objectives/UnlockRuleDefinition.cs" />
    <Compile Include="../../src/TheRaceForSpace/Objectives/UnlockRuleEvaluator.cs" Link="Production/Objectives/UnlockRuleEvaluator.cs" />
    <Compile Include="../../src/TheRaceForSpace/Agencies/AgencyState.cs" Link="Production/Agencies/AgencyState.cs" />
    <Compile Include="../../src/TheRaceForSpace/Rivals/RivalSimulation.cs" Link="Production/Rivals/RivalSimulation.cs" />
    <Compile Include="../../src/TheRaceForSpace/Tracking/VesselTrackingSnapshot.cs" Link="Production/Tracking/VesselTrackingSnapshot.cs" />
    <Compile Include="../../src/TheRaceForSpace/Tracking/ActiveVesselTrackingSnapshot.cs" Link="Production/Tracking/ActiveVesselTrackingSnapshot.cs" />
    <Compile Include="../../src/TheRaceForSpace/Tracking/SatelliteTracker.cs" Link="Production/Tracking/SatelliteTracker.cs" />
    <Compile Include="../../src/TheRaceForSpace/Tracking/StarterFlightTracker.cs" Link="Production/Tracking/StarterFlightTracker.cs" />
  </ItemGroup>
</Project>
