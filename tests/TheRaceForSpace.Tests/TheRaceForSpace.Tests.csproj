<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>TheRaceForSpace.Tests</AssemblyName>
    <RootNamespace>TheRaceForSpace.Tests</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    The prototype assembly depends on KSP and Unity, so these tests compile only
    the domain source files that are intentionally independent of those APIs.
    The real race controller is also compiled against test-only stand-ins for its
    existing KSP integration boundaries so controller ordering can be exercised in CI.
  -->
  <ItemGroup>
    <Compile Include="../../src/TheRaceForSpace/Competition/SatelliteRaceController.cs" Link="Production/Competition/SatelliteRaceController.cs" />
    <Compile Include="../../src/TheRaceForSpace/Funding/FundingProgramme.cs" Link="Production/Funding/FundingProgramme.cs" />
    <Compile Include="../../src/TheRaceForSpace/Funding/AchievementFundingProgramme.cs" Link="Production/Funding/AchievementFundingProgramme.cs" />
    <Compile Include="../../src/TheRaceForSpace/Funding/PrototypeFundingCatalogue.cs" Link="Production/Funding/PrototypeFundingCatalogue.cs" />
    <Compile Include="../../src/TheRaceForSpace/Milestones/MilestoneDefinition.cs" Link="Production/Milestones/MilestoneDefinition.cs" />
    <Compile Include="../../src/TheRaceForSpace/Milestones/PrototypeMilestones.cs" Link="Production/Milestones/PrototypeMilestones.cs" />
    <Compile Include="../../src/TheRaceForSpace/Programs/SpaceProgramState.cs" Link="Production/Programs/SpaceProgramState.cs" />
    <Compile Include="../../src/TheRaceForSpace/Simulation/RivalSimulation.cs" Link="Production/Simulation/RivalSimulation.cs" />
    <Compile Include="../../src/TheRaceForSpace/Tracking/VesselTrackingSnapshot.cs" Link="Production/Tracking/VesselTrackingSnapshot.cs" />
    <Compile Include="../../src/TheRaceForSpace/Tracking/SatelliteTracker.cs" Link="Production/Tracking/SatelliteTracker.cs" />
    <Compile Include="../../src/TheRaceForSpace/Persistence/RaceProgressSaveState.cs" Link="Production/Persistence/RaceProgressSaveState.cs" />
    <Compile Include="../../src/TheRaceForSpace/Persistence/RivalProgramSaveState.cs" Link="Production/Persistence/RivalProgramSaveState.cs" />
    <Compile Include="../../src/TheRaceForSpace/Persistence/RivalProgramsSaveState.cs" Link="Production/Persistence/RivalProgramsSaveState.cs" />
  </ItemGroup>
</Project>
