<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>TheRaceForSpace.Tests</AssemblyName>
    <RootNamespace>TheRaceForSpace.Tests</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    The prototype assembly depends on KSP and Unity, so these tests compile only
    the domain source files that are intentionally independent of those APIs.
    This keeps the regression suite runnable without a KSP installation or a
    third-party test framework.
  -->
  <ItemGroup>
    <Compile Include="../../src/TheRaceForSpace/Core/CampaignSettings.cs" Link="Production/Core/CampaignSettings.cs" />
    <Compile Include="../../src/TheRaceForSpace/Funding/SatelliteNetworkFundingContract.cs" Link="Production/Funding/SatelliteNetworkFundingContract.cs" />
    <Compile Include="../../src/TheRaceForSpace/Funding/ObjectiveFundingContract.cs" Link="Production/Funding/ObjectiveFundingContract.cs" />
    <Compile Include="../../src/TheRaceForSpace/Funding/FundingContractCatalogue.cs" Link="Production/Funding/FundingContractCatalogue.cs" />
    <Compile Include="../../src/TheRaceForSpace/Objectives/ObjectiveDefinition.cs" Link="Production/Objectives/ObjectiveDefinition.cs" />
    <Compile Include="../../src/TheRaceForSpace/Objectives/ObjectiveCatalogue.cs" Link="Production/Objectives/ObjectiveCatalogue.cs" />
    <Compile Include="../../src/TheRaceForSpace/Objectives/UnlockRuleDefinition.cs" Link="Production/Objectives/UnlockRuleDefinition.cs" />
    <Compile Include="../../src/TheRaceForSpace/Objectives/UnlockRuleEvaluator.cs" Link="Production/Objectives/UnlockRuleEvaluator.cs" />
    <Compile Include="../../src/TheRaceForSpace/Agencies/AgencyState.cs" Link="Production/Agencies/AgencyState.cs" />
    <Compile Include="../../src/TheRaceForSpace/Rivals/RivalSimulation.cs" Link="Production/Rivals/RivalSimulation.cs" />
    <Compile Include="../../src/TheRaceForSpace/Tracking/OrbitingVesselSnapshot.cs" Link="Production/Tracking/OrbitingVesselSnapshot.cs" />
    <Compile Include="../../src/TheRaceForSpace/Tracking/ActiveVesselSnapshot.cs" Link="Production/Tracking/ActiveVesselSnapshot.cs" />
    <Compile Include="../../src/TheRaceForSpace/Tracking/OrbitalVesselTracker.cs" Link="Production/Tracking/OrbitalVesselTracker.cs" />
    <Compile Include="../../src/TheRaceForSpace/Tracking/FlightContractTracker.cs" Link="Production/Tracking/FlightContractTracker.cs" />
    <Compile Include="../../src/TheRaceForSpace/Tracking/SurfaceImpactEvaluator.cs" Link="Production/Tracking/SurfaceImpactEvaluator.cs" />
    <Compile Include="../../src/TheRaceForSpace/Persistence/FundingContractsSaveState.cs" Link="Production/Persistence/FundingContractsSaveState.cs" />
    <Compile Include="../../src/TheRaceForSpace/Persistence/RivalAgenciesSaveState.cs" Link="Production/Persistence/RivalAgenciesSaveState.cs" />
    <Compile Include="../../src/TheRaceForSpace/Persistence/ActiveContractProgressSaveState.cs" Link="Production/Persistence/ActiveContractProgressSaveState.cs" />
  </ItemGroup>
</Project>
